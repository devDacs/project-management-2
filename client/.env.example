# Express API origin/base URL. Include the trailing slash for RTK Query URLs.
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/"

# HTTPS base URL for profile pictures and task attachment URLs.
# Do not use credentials or signed secrets in this public variable.
NEXT_PUBLIC_IMAGE_BASE_URL="https://replace-with-image-host.example.com"

# AWS Cognito User Pool and App Client IDs. These values are public configuration.
NEXT_PUBLIC_COGNITO_USER_POOL_ID="us-east-1_replace_with_pool_id"
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID="replace_with_app_client_id"
